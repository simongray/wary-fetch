{:deps   {:aliases [:cljs]}
 :builds {;; clojure -M:cljs compile test (the tests of the browser's
          ;; client, which fetch the files of their page, stay out)
          :test         {:target    :node-test
                         :output-to "target/node-tests.js"
                         :ns-regexp "(?<!\\.browser)-test$"
                         :autorun   true}
          ;; clojure -M:cljs compile browser-test, then
          ;; node test/browser-run.mjs target/browser-test (the tests of
          ;; Node's own client stay out)
          :browser-test {:target    :browser-test
                         :test-dir  "target/browser-test"
                         :ns-regexp "(?<!\\.node)-test$"
                         :runner-ns dk.simongray.wary-fetch.browser-runner}}}
